<?xml version="1.0" encoding="utf-8"?>
<!-- Ab API 31: gleiche Ausnahmen wie in backup_rules.xml, für Cloud-Backup
     und Gerät-zu-Gerät-Übertragung. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="memory_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="memory_settings.xml" />
    </device-transfer>
</data-extraction-rules>
